# CORS Configuration
# Comma-separated list of allowed origins
# For local development with Vite frontend:
CORS_ORIGINS=http://localhost:5173

# For testing deployed frontend against local backend via tunnel:
# CORS_ORIGINS=https://kena-dashboard.pulseaddis.com,https://your-ngrok-url.ngrok.io

# For production (Vercel sets this automatically):
# CORS_ORIGINS=https://kena-dashboard.pulseaddis.com

# Other required environment variables
PORT=4000
NODE_ENV=development
JWT_SECRET=your-jwt-secret-here
DATABASE_URL=your-postgresql-url
# ... other vars from your Vercel dashboard